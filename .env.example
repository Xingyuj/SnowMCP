SERVICENOW_BASE_URL=https://example.service-now.com
SERVICENOW_KNOWLEDGE_API_PATH=api/sn_km_api/knowledge/articles
SERVICENOW_CATEGORIES_API_PATH=api/now/table/kb_category
SERVICENOW_ACCESS_TOKEN=
SERVICENOW_CLIENT_ID=replace-with-servicenow-client-id
SERVICENOW_CLIENT_SECRET=replace-with-servicenow-client-secret
SERVICENOW_OAUTH_TOKEN_PATH=oauth_token.do
SERVICENOW_OAUTH_SCOPE=
# APIM validates the Entra ID token and forwards the original Authorization header.
# Network controls must guarantee that this server is reachable only through APIM.
APIM_AUTH_ENABLED=false
APIM_SCOPE_CLAIM_NAMES=scp,scope,roles
APIM_SUBJECT_CLAIM_NAMES=oid,sub
MCP_SEARCH_SCOPE=knowledge.search
MCP_CATEGORY_READ_SCOPE=knowledge.category.read
MCP_ARTICLE_READ_SCOPE=knowledge.article.read
SERVICENOW_API_VERSION=
SERVICENOW_KNOWLEDGE_BASE=
SERVICENOW_LANGUAGE=
SERVICENOW_SEARCH_FIELDS=sys_id,number,short_description,description,kb_knowledge_base,score
SERVICENOW_ARTICLE_FIELDS=sys_id,number,short_description,text,kb_knowledge_base,kb_category,workflow_state,published,valid_to,sys_updated_on
SERVICENOW_CATEGORY_FIELDS=sys_id,label,value,parent_id,full_category,active
REQUEST_TIMEOUT_SECONDS=10
DEFAULT_SEARCH_LIMIT=5
MAX_SEARCH_LIMIT=20
CATEGORY_PAGE_SIZE=100
MAX_ARTICLE_CONTENT_CHARS=100000
TRANSIENT_RETRY_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=0.2
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
